// Skemos — Waybar. Thin, top only, one row. Title-block feel.
// workspaces · MODE | window | MIN · audio · tray · clock
{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "fixed-center": true,

  "modules-left":   ["custom/sheet", "hyprland/workspaces", "custom/mode"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["custom/minimized", "cpu", "memory", "custom/temp", "network", "wireplumber", "custom/rev", "clock"],

  // operator stamp — the logged-in user, left of the coordinate row
  "custom/sheet": {
    "exec": "id -un | tr '[:lower:]' '[:upper:]'",
    "format": "{}",
    "tooltip": false
  },

  // coordinate row: zero-padded slot numbers, 5 always present, more appear as
  // used. The active slot is marked in CSS (orange underline). Bump the "*"
  // count for more permanent slots.
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "01", "2": "02", "3": "03", "4": "04", "5": "05",
      "6": "06", "7": "07", "8": "08", "9": "09", "10": "10",
      "urgent": "!!", "default": "··"
    },
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": { "*": [1, 2, 3, 4, 5] }
  },

  // TILE / DESK for the ACTIVE workspace. Polled + signalled (modes.lua sends
  // SIGRTMIN+8 on toggle for an instant update).
  "custom/mode": {
    "exec": "~/.config/waybar/scripts/mode.sh",
    "return-type": "json",
    "format": "MODE {}",
    "interval": 1,
    "signal": 8
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
    "rewrite": { "": "—" }
  },

  // Count of windows parked in special:minimized. Hidden when zero.
  "custom/minimized": {
    "exec": "~/.config/waybar/scripts/minimized.sh",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"minimized\")'"
  },

  // --- telemetry cluster -------------------------------------------------
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": "MEM {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "custom/temp": {
    "exec": "~/.config/waybar/scripts/temp.sh",
    "return-type": "json",
    "interval": 5
  },
  "network": {
    "format-ethernet": "NET {bandwidthDownBytes}",
    "format-wifi": "NET {signalStrength}",
    "format-disconnected": "NET ✕",
    "interval": 3,
    "tooltip-format": "{ifname}  {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}"
  },

  "wireplumber": {
    "format": "SND {volume}",
    "format-muted": "SND ✕",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "max-volume": 100,
    "tooltip": false
  },

  // drawing revision — ~/.config git HEAD, "*" = dirty tracked tree
  "custom/rev": {
    "exec": "~/.config/waybar/scripts/rev.sh",
    "return-type": "json",
    "interval": 30,
    "on-click": "foot -e sh -c 'cd ~/.config && git log --oneline -20 && read -n1 -p \"\"'"
  },

  "clock": {
    "format": "{:%Y-%m-%d  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": { "today": "<b>{}</b>" }
    }
  }
}
