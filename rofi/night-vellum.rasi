/* Night Vellum — rofi theme. Dark + off-white, reversed technical drawing.
   Monochrome frame; one burnt-orange detail on the prompt. Selection inverts
   to a white block (e-ink highlight). Squared, hairline. */

* {
    nv-bg:      #161513;
    nv-raised:  #1e1d19;
    nv-ink:     #e5e1d6;
    nv-ink-dim: #9a948a;
    nv-faint:   #55514a;
    nv-rule:    #34322d;
    nv-accent:  #c1663a;

    background-color: transparent;
    text-color:       @nv-ink;
    font:             "Iosevka 11";
}

/* double rule: outer @nv-rule, a bg gap, inner @nv-faint hairline —
   the technical frame that boxes a part on a schematic sheet */
window {
    background-color: @nv-bg;
    border:           1px;
    border-color:     @nv-rule;
    border-radius:    0;
    width:            36em;
    padding:          5px;
    location:         center;
}

mainbox {
    border:       1px;
    border-color: @nv-faint;
    padding:      0;
    children:     [ inputbar, message, listview ];
}

inputbar {
    background-color: @nv-raised;
    border:           0 0 1px 0;
    border-color:     @nv-rule;
    padding:          8px 10px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @nv-accent;      /* the one orange detail */
    str:        "run ▸";
}

entry {
    placeholder:        "";
    placeholder-color:  @nv-ink-dim;
    cursor:             text;
}

message {
    background-color: @nv-raised;
    border:           0 0 1px 0;
    border-color:     @nv-rule;
    padding:          6px 10px;
}

listview {
    lines:        10;
    padding:      4px 0;
    scrollbar:    false;
    dynamic:      true;
    fixed-height: false;
}

element {
    padding:      4px 12px;
    text-color:   @nv-ink-dim;
}
element normal active   { text-color: @nv-ink; }
element selected {
    background-color: @nv-ink;      /* inverted white block */
    text-color:       @nv-bg;
}
element selected active { text-color: @nv-bg; }

element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 0; }
