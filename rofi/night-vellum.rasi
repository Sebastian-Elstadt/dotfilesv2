/* Night Vellum — rofi theme. Dark + off-white, reversed technical drawing.
   Monochrome frame; one burnt-orange detail on the prompt. Selection inverts
   to a white block (e-ink highlight). Squared, hairline. */

* {
    nv-bg:      #161513;
    nv-raised:  #1e1d19;
    nv-ink:     #e5e1d6;
    nv-ink-dim: #9a948a;
    nv-faint:   #55514a;
    nv-rule:    #34322d;
    nv-accent:  #c1663a;

    background-color: transparent;
    text-color:       @nv-ink;
    font:             "Iosevka 11";
}

/* right-side panel: full screen height below the 22px waybar, hard left edge.
   Hyprland slides it in from the right (layer rule in hypr/rules.lua). */
window {
    background-color: @nv-raised;
    border:           0 0 0 1px;      /* only the edge facing the screen */
    border-color:     @nv-rule;
    border-radius:    0;
    width:            460px;
    height:           100%;           /* 100% == the area below the waybar */
    padding:          6px;
    location:         northeast;
    anchor:           northeast;
    y-offset:         0;
    x-offset:         0;
}

mainbox {
    border:       1px;
    border-color: @nv-faint;
    padding:      0;
    children:     [ inputbar, message, listview ];
}

inputbar {
    background-color: @nv-raised;
    border:           0 0 1px 0;
    border-color:     @nv-rule;
    padding:          8px 10px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @nv-accent;      /* the one orange detail */
    str:        "run ▸";
}

entry {
    placeholder:        "";
    placeholder-color:  @nv-ink-dim;
    cursor:             text;
}

message {
    background-color: @nv-raised;
    border:           0 0 1px 0;
    border-color:     @nv-rule;
    padding:          6px 10px;
}

listview {
    padding:      4px 0;
    scrollbar:    false;
    dynamic:      false;
    fixed-height: true;      /* fill the panel */
    expand:       true;
}

element {
    padding:      4px 12px;
    text-color:   @nv-ink-dim;
}
element normal active   { text-color: @nv-ink; }
element selected {
    background-color: @nv-ink;      /* inverted white block */
    text-color:       @nv-bg;
}
element selected active { text-color: @nv-bg; }

element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 0; }
